# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider selection: vietqr_static (default, real QR / no auto-detection)
# or sepay (not implemented yet, see src/modules/payments/domain/providers/sepay-provider.ts)
PAYMENT_PROVIDER=vietqr_static

# BEWINE receiving bank account (used to build the VietQR code)
BEWINE_BANK_BIN=
BEWINE_BANK_ACCOUNT_NUMBER=
BEWINE_BANK_ACCOUNT_HOLDER=
BEWINE_BANK_NAME=
VIETQR_TEMPLATE=compact2

# Minutes an order stays pending before it's auto-cancelled and its
# reserved stock released (see netlify/functions/expire-stale-orders.ts)
ORDER_PAYMENT_WINDOW_MINUTES=30

# Admin area (see ECOMMERCE_SETUP.md)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: staff order notifications via a Telegram bot (see ECOMMERCE_SETUP.md,
# section 5). Leave both unset to disable this channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: staff order notifications via a Slack Incoming Webhook — an
# alternative to Telegram above (see ECOMMERCE_SETUP.md, section 5b).
# Leave unset to disable this channel.
SLACK_WEBHOOK_URL=

# Optional: Zalo ZNS "payment confirmed" message to the customer (see
# ECOMMERCE_SETUP.md, section 6). App ID/Secret come from the Zalo
# Developers app linked to your OA; the OAuth tokens themselves are
# obtained separately by visiting /api/admin/zalo/authorize once logged
# into /admin, and are stored in the database, not here.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_ZNS_TEMPLATE_ID=

# Optional: staff order processing via a ClickUp task per new order (see
# ECOMMERCE_SETUP.md, section 7). Leave both unset to disable this channel.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
# Optional: auto-assigns each new task to this ClickUp user id (numeric).
CLICKUP_ASSIGNEE_ID=
