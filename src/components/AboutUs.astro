---
import { getLangFromUrl, useTranslations } from "src/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Lines within the same paragraph (soft line breaks), not separate
// paragraphs — keeps a single, uniformly-weighted block of text instead of
// stacking multiple mb-4-spaced <p>s with only the last one bold.
const lines = t('hero.description').split('\n').filter(Boolean);
---

<section class="relative w-full bg-sirah-50 px-6 py-12 md:px-20 md:py-24">
  <div class="max-w-[1440px] mx-auto flex flex-col lg:flex-row gap-8 lg:gap-9 lg:items-center">
    <h1 class="font-serif font-normal text-[#86181b] text-4xl md:text-6xl lg:text-8xl leading-tight lg:w-2/5 lg:shrink-0 m-0">
      <span class="block">{t('about.title.line1')}</span>
      <span class="block">{t('about.title.line2')}</span>
      <span class="block">{t('about.title.line3')}</span>
    </h1>
    <p class="flex-1 min-w-0 m-0 text-[#252525] text-base md:text-2xl leading-relaxed font-semibold">
      {lines.map((line, i) => (
        <>
          {line}
          {i < lines.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
</section>
