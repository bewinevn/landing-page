---
import { Image } from "astro:assets";

import banner from '../assets/L1460435.JPG';

---

<dialog class="rounded-md backdrop:bg-black/50 backdrop:backdrop-blur-md opacity-90 max-h-96 aspect-video">
    <div class="flex flex-row justify-center h-full w-full aspect-square">
        <div class="flex flex-col m-5 justify-items-end">
            <h2 class="flex flex-grow my-5 font-serif font-extrabold text-5xl text-left text-concord-700">
                Tuổi gì mà đòi uống?
            </h2>
    
            <div class="flex flex-row my-5">
                <button type="button" id="button_yes" class="w-1/2 mr-5 text-white bg-concord-700 hover:bg-concord-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2  focus:outline-none">Đã đủ 18 tuổi</button>
                <button type="button" id="button_no" class="w-1/2 text-gray-900 bg-white border border-concord-700 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2">Em còn bé lắm 🥺👉👈</button>
            </div>

        </div>
        <div class="md:flex md:w-full hidden">
            <Image src={banner} alt="Age Verification" class=""/>
        </div>
    </div>
</dialog>

<script is:inline>
    const dialog = document.querySelector("dialog");
    const closeButton = document.querySelector("#button_yes");

    window.onload = (() => {
        if (localStorage.getItem("ageVerification") !== 'true') {
            dialog.showModal();
        }
    })

    closeButton.addEventListener("click", (event) => {
        event.preventDefault();
        localStorage.setItem("ageVerification", 'true');
        dialog.close();
    });
</script>
