---
import { Image } from 'astro:assets';
import { getLangFromUrl } from 'src/i18n/utils';
import {
  BLACK_FRIDAY_COMBO,
  BLACK_FRIDAY_END,
  ZALO_ORDER_LINK,
  isBlackFridayActive,
  blackFridayText,
} from 'src/config/blackFriday';
import coverImg from '../assets/black-friday-cover.jpg';

const lang = getLangFromUrl(Astro.url);
const text = blackFridayText(lang);
const t = (key: string) => text[key.replace('blackfriday.', '') as keyof typeof text];

// Rendered only during the Black Friday window (26/11 - 28/11, Vietnam time).
const active = isBlackFridayActive();
// "Đặt ngay" opens the combo on /products; English has no products page yet, so it goes to Zalo.
const orderHref = lang === 'en' ? ZALO_ORDER_LINK : '/products?combo=black-friday';
const orderExternal = lang === 'en';
const orderLinkAttrs = orderExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{active && (
  <section
    id="black-friday-combo"
    class="black-friday-combo relative w-full bg-black text-white px-5 py-16 md:px-[120px] md:py-20 scroll-mt-4"
    data-promo-end={BLACK_FRIDAY_END}
  >
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <a href={orderHref} {...orderLinkAttrs} class="block rounded-2xl overflow-hidden shadow-2xl">
        <Image
          src={coverImg}
          alt="be-wine Black Friday combo 6 lon: Sauvignon Blanc, Zinfandel, 2 Petite Sirah, 2 Cabernet Sauvignon"
          class="w-full h-auto"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 560px, 100vw"
          loading="lazy"
        />
      </a>

      <div class="flex flex-col gap-6">
        <p class="m-0 font-mono uppercase tracking-widest text-sm text-white/70">{t('blackfriday.eyebrow')}</p>
        <h2 class="m-0 text-4xl md:text-6xl font-bold uppercase leading-none">{t('blackfriday.title')}</h2>
        <p class="m-0 text-lg md:text-xl font-bold uppercase text-sirah-500">{t('blackfriday.tagline')}</p>

        <div class="flex items-end gap-4 flex-wrap">
          <span class="text-2xl md:text-3xl text-white/50 line-through">{BLACK_FRIDAY_COMBO.oldPrice}</span>
          <span class="text-5xl md:text-7xl font-bold text-white leading-none">
            {BLACK_FRIDAY_COMBO.price}<span class="text-xl md:text-2xl font-medium text-white/70">{t('blackfriday.unit')}</span>
          </span>
        </div>
        <p class="m-0 text-lg">{t('blackfriday.subtitle')}</p>

        <div class="rounded-xl border border-white/20 p-4">
          <p class="m-0 mb-3 font-bold uppercase text-sm tracking-wide text-white/70">{t('blackfriday.includes')}</p>
          <ul class="m-0 p-0 list-none grid grid-cols-1 sm:grid-cols-2 gap-2">
            {BLACK_FRIDAY_COMBO.items.map((item) => (
              <li class="flex items-center gap-3">
                <span class="inline-flex items-center justify-center min-w-[2.25rem] h-7 rounded bg-white text-black font-bold text-sm">x{item.qty}</span>
                <span class="capitalize">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>

        <a
          href={orderHref}
          {...orderLinkAttrs}
          class="inline-flex self-start items-center justify-center bg-[#A71E22] hover:bg-sirah-800 text-white font-sans font-bold uppercase text-lg rounded-xl px-8 py-4 shadow-lg"
        >
          {t('blackfriday.cta')}
        </a>
        <p class="m-0 text-sm text-white/60">{t('blackfriday.note')}</p>
      </div>
    </div>
  </section>
)}

<script is:inline>
  // Guard against a cached page still showing the expired combo.
  document.querySelectorAll('.black-friday-combo[data-promo-end]').forEach((el) => {
    if (Date.now() >= Date.parse(el.dataset.promoEnd)) el.remove();
  });
</script>
