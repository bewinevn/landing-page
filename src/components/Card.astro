---
import { Image } from 'astro:assets';

const { title, subtitle, image, link, imageStyle, description } = Astro.props;

const isComingSoon = /coming soon/i.test(title);
const displayTitle = title.replace(/[\s-]*coming soon/i, '').trim();
---

<figure class="shrink-0 w-full relative">
  <div class="relative">
    <a href={link} target="_blank" class:list={["no-underline relative block", link && "hover:scale-105"]} aria-label={title}>
      <span class="relative block transition duration-500 ease-in-out transform rounded">
        <Image 

          class:list={["relative block object-contain object-center w-full h-full", imageStyle]} 
          loading="lazy" 
          alt={title} src={image} />
      </span>
      </a>
  </div>
    <h3 class="text-sauvignon-800 text-xl mt-2">
        {displayTitle}
        {isComingSoon && <span class="text-sirah-600 font-semibold"> coming soon</span>}
</h3>
  </div>
    {
    subtitle && (
      <div class="px-0 pb-2 opacity-80">
        <h4 class="whitespace-pre-line">{subtitle}</h4>
      </div>
    )
  }
  {
    description && (
      <div>
        <p>{description}</p>
      </div>
    )
  }
</figure>
