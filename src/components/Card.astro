---
import { getLangFromUrl, useTranslations } from "src/i18n/utils";

interface Props {
  title: string;
  abbreviation?: string;
  subtitle?: string;
  image: string;
  isComingSoon?: boolean;
  // e-commerce affordance (optional — omit to render exactly as before)
  productId?: string;
  priceVnd?: number;
  availableQty?: number;
  showAddToCart?: boolean;
  showBuyNow?: boolean;
}

const {
  title,
  abbreviation = '',
  subtitle,
  image,
  isComingSoon = false,
  productId,
  priceVnd,
  availableQty,
  showAddToCart = false,
  showBuyNow = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const notes = subtitle ? subtitle.split('\n').filter(Boolean) : [];
const outOfStock = showAddToCart && (availableQty ?? 0) <= 0;
---

<style>
  .card-texture {
    background-image: url("../assets/topography.svg");
    background-size: 384px 384px;
    background-position: top left;
    opacity: 0.5;
  }
</style>

<figure class="relative flex flex-col gap-3 items-start p-4 rounded-lg bg-[#EFEDE9] overflow-hidden m-0">
  <div class="card-texture absolute inset-0 pointer-events-none"></div>

  <div class="relative w-full">
    {isComingSoon ? (
      <div class="flex h-[30px] w-full items-center justify-center rounded bg-white border border-[#d1d5db]">
        <p class="font-sans font-bold text-[#A71E22] text-lg md:text-xl m-0">{t('winelist.comingsoon')}</p>
      </div>
    ) : (
      <div class="flex h-[30px] w-full items-center justify-center rounded bg-[#A71E22] border border-[#d1d5db]">
        <p class="font-sans font-bold text-[#EFEDE9] text-lg md:text-xl m-0">{t('winelist.promo')}</p>
      </div>
    )}
  </div>

  <div class="relative w-full h-[260px] md:h-[300px] flex items-center justify-center">
    <img class="w-auto h-full object-contain" loading="lazy" alt={title} src={image} />
  </div>

  <div class="relative flex gap-2 items-center w-full">
    <p class="font-sans font-bold text-[#A71E22] text-2xl md:text-4xl m-0 capitalize">{title}</p>
    {abbreviation && (
      <span class="inline-flex items-center justify-center h-[30px] w-[43px] shrink-0 rounded bg-white border border-[#d1d5db] font-sans font-bold text-[#A71E22] text-lg">
        {abbreviation}
      </span>
    )}
  </div>

  <div class="relative w-full h-[195px] p-2 rounded bg-[#f0f0f0] border border-[#ccc] overflow-y-auto">
    {notes.map(line => <p class="m-0 text-[#666] text-base uppercase leading-normal">{line}</p>)}
    <p class="m-0 text-base">&nbsp;</p>
    <p class="m-0 font-bold text-[#A71E22] text-sm uppercase">{t('winelist.ingredients')}</p>
    <p class="m-0 text-[#A71E22] text-sm uppercase">
      <span class="font-bold">{t('winelist.hsdLabel')} </span>
      <span>{t('winelist.hsdText')}</span>
    </p>
  </div>

  {!isComingSoon && !showAddToCart && (
    <div class="relative flex min-h-[30px] w-full items-center justify-center rounded bg-[#A71E22] border border-[#d1d5db] px-2 py-1.5">
      <p class="m-0 text-[#f0f0f0] text-xs md:text-sm text-center leading-snug">
        {t('winelist.disclaimerPrefix')} <span class="underline">{t('winelist.disclaimerLimited')}</span> {t('winelist.disclaimerMiddle')} <span class="underline">{t('winelist.disclaimerArea')}</span>
      </p>
    </div>
  )}

  {showAddToCart && !isComingSoon && productId && priceVnd != null && (
    <div class="relative flex flex-col gap-3 w-full">
      <div class="flex items-center justify-between gap-3 w-full">
        <p class="font-sans font-bold text-[#A71E22] text-xl m-0">{priceVnd.toLocaleString('vi-VN')} ₫</p>
        {showBuyNow && !outOfStock && (
          <input
            type="number"
            min="1"
            max={availableQty ?? undefined}
            value="1"
            data-qty-input
            data-product-id={productId}
            class="w-16 rounded border border-[#d1d5db] px-2 py-2 text-center text-sm"
          />
        )}
      </div>
      <div class="flex items-center gap-2 w-full">
        <button
          type="button"
          data-add-to-cart
          data-product-id={productId}
          disabled={outOfStock}
          class="flex-1 inline-flex items-center justify-center rounded bg-[#A71E22] disabled:bg-[#ccc] disabled:cursor-not-allowed text-white font-sans font-bold text-sm px-4 py-2 hover:brightness-110 transition"
        >
          {outOfStock ? t('product.outOfStock') : t('product.addToCart')}
        </button>
        {showBuyNow && !outOfStock && (
          <button
            type="button"
            data-buy-now
            data-product-id={productId}
            class="flex-1 inline-flex items-center justify-center rounded border-2 border-[#A71E22] text-[#A71E22] font-sans font-bold text-sm px-4 py-2 hover:bg-[#A71E22]/10 transition"
          >
            {t('product.buyNow')}
          </button>
        )}
      </div>
    </div>
  )}
</figure>
