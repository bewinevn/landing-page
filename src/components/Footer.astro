---
import { getEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const general = await getEntry('settings','general');
const footer = await getEntry('settings','footer');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="relative w-full bg-[#A71E22] px-5 py-10 md:px-[120px] md:py-12">
  <div class="max-w-[1200px] mx-auto flex items-center">
    <div class="w-full flex flex-col items-center text-center gap-6 md:flex-row md:flex-wrap md:text-left">
      <p class="text-2xl md:text-xl font-bold text-sirah-50 whitespace-nowrap m-0">
        {t('footer.cta')}
      </p>

      <div class="flex flex-wrap justify-center gap-4 md:contents">
        {footer.data.socials.map(
          social =>
            <a href={social.link}
            target={social.target}
            class="inline-flex items-center justify-center w-32 md:w-40 h-12 border border-white/40 rounded text-sirah-50 font-medium text-sm text-center capitalize whitespace-nowrap underline hover:bg-white/10"
            rel="noopener">
              {social.name}
            </a>
        )}

        <a href="https://zalo.me/3836034200863507097"
          target="_blank"
          class="inline-flex items-center justify-center w-32 md:w-40 h-12 border border-white/40 rounded text-sirah-50 font-medium text-sm text-center whitespace-nowrap underline hover:bg-white/10"
          rel="noopener">
          {t('footer.hotline')}
        </a>
      </div>

      <p class="text-sm text-sirah-50 md:ml-auto whitespace-nowrap m-0">
        &copy; Copyright {general.data.title} {new Date().getFullYear()}. All rights reserved
      </p>
    </div>
  </div>
</footer>
