---
import { getEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const general = await getEntry('settings','general');
const footer = await getEntry('settings','footer');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="relative w-full bg-[#A71E22] px-5 py-10 md:px-[120px] md:py-12">
  <div class="max-w-[1200px] mx-auto flex items-center">
    <div class="w-full flex flex-col items-center text-center gap-6 md:flex-row md:items-start md:justify-between md:gap-12 md:text-left">
      <div class="flex flex-col items-center gap-6 md:order-2 md:items-end md:gap-4 md:shrink-0 md:max-w-[340px] xl:max-w-none">
      <p class="text-2xl md:text-xl font-bold text-sirah-50 whitespace-nowrap m-0 md:text-right">
        {t('footer.cta')}
      </p>

      <div class="flex flex-wrap justify-center gap-4 md:justify-end">
        {footer.data.socials.map(
          social =>
            <a href={social.link}
            target={social.target}
            class="inline-flex items-center justify-center w-32 md:w-40 h-12 border border-white/40 rounded text-sirah-50 font-medium text-sm text-center capitalize whitespace-nowrap underline hover:bg-white/10"
            rel="noopener">
              {social.name}
            </a>
        )}

        <a href="https://zalo.me/3836034200863507097"
          target="_blank"
          class="inline-flex items-center justify-center w-32 md:w-40 h-12 border border-white/40 rounded text-sirah-50 font-medium text-sm text-center whitespace-nowrap underline hover:bg-white/10"
          rel="noopener">
          {t('footer.hotline')}
        </a>
      </div>
      </div>

      <div class="w-full md:flex-1 md:max-w-[620px] md:order-1 flex flex-col gap-1 text-center md:text-left text-sirah-50">
        <p class="text-xs md:text-sm font-bold m-0">{t('footer.company')}</p>
        <p class="text-xs md:text-sm m-0">{t('footer.registration')}</p>
        <p class="text-xs md:text-sm m-0">{t('footer.foodSafety')}</p>
        <p class="text-sm m-0 mt-2">
          &copy; Copyright {general.data.title} {new Date().getFullYear()}. All rights reserved
        </p>
      </div>
    </div>
  </div>
</footer>
