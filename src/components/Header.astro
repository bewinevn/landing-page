---
import LanguagePicker from '../components/LanguagePicker.astro'
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

// There's no English products/checkout flow yet (only the English home
// page exists) — send English visitors straight to Zalo instead of a
// dead /en/products link.
const orderHref = lang === 'en' ? 'https://zalo.me/3836034200863507097' : translatePath('/products');
---

<header class="sticky top-0 z-40 bg-[#A71E22] px-4 py-3 md:px-8">
  <div class="flex items-center justify-between gap-3 md:gap-4">
    <a href={translatePath('/')} class="shrink-0">
      <img src="/figma/hero-wave-logo.svg" alt="be-wine" class="h-4 md:h-7 w-auto" />
    </a>

    <div class="flex items-center gap-3 md:gap-6">
      <a
        href={orderHref}
        target={lang === 'en' ? '_blank' : undefined}
        rel={lang === 'en' ? 'noopener' : undefined}
        class="inline-flex items-center justify-center rounded-xl bg-white text-[#A71E22] font-sans font-bold text-base px-3 py-1.5 md:px-5 md:py-2.5 whitespace-nowrap hover:brightness-95 transition"
      >
        {t('nav.orderNow')}
      </a>
      <a href="/about" class="text-white hover:underline text-base font-sans font-medium whitespace-nowrap">
        {t('nav.about')}
      </a>
      <LanguagePicker />
    </div>
  </div>
</header>
