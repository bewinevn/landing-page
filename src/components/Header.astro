---
import { getLangFromUrl, useTranslations } from 'src/i18n/utils';
import { getEntry } from 'astro:content';
import LanguagePicker from '../components/LanguagePicker.astro'

const general = await getEntry('settings','general');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="block relative">
  <div class="flex flex-col">
    <div class="flex flex-col w-full mx-auto px-8 py-16 md:max-w-7xl">
      <div class="flex grow flex-wrap items-center">
        <a href="https://zalo.me/3836034200863507097" class="flex w-auto basis-0 grow min-w-0 max-w-full items-center flex-[0_0_auto] gap-6">
          <span class="inline-flex items-center bg-sirah-700 hover:bg-sirah-800 text-white font-sans font-medium text-lg rounded-full px-6 py-3 transition-colors shadow-sm">
            {t('wheretofind.nav')}
          </span>
        </a>
        <LanguagePicker />
      </div>
    </div>
  </div>
</header>
