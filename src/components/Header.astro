---
import LanguagePicker from '../components/LanguagePicker.astro'
import { Image } from 'astro:assets'
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils'
import logo from '../assets/bewinelogo.png'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<header class="sticky top-0 z-40 flex items-center justify-between pointer-events-none">
  <a href={translatePath('/')} class="pointer-events-auto bg-sirah-50/90 backdrop-blur-sm rounded-br-lg px-4 py-2 md:px-6 md:py-3">
    <Image src={logo} alt="be-wine" class="h-5 md:h-6 w-auto" />
  </a>
  <div class="pointer-events-auto flex items-center gap-4 bg-sirah-50/90 backdrop-blur-sm rounded-bl-lg px-4 py-2 md:px-6 md:py-3">
    <a href={translatePath('/products')} class="font-sans font-bold text-sm md:text-base text-sauvignon-700 whitespace-nowrap hover:underline">
      {t('nav.orderNow')}
    </a>
    <LanguagePicker />
  </div>
</header>
