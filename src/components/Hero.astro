---
import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import { Image } from 'astro:assets';
import promoImage from '../assets/mua1-tang1-mua-thu.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
  <div class="order-2 lg:order-1 max-w-xl pr-5">
    <div class="relative mt-5 mb-0">
      <h2 class="font-light font-serif text-4xl leading-none -tracking-wider mt-0 mb-8 mx-0">
        <p class="mb-6 text-pretty">
          <div><span class="text-[1.5em]">{t('hero.title')}</span></div>
          <span class="text-[1.5em]">{t('hero.subtitle')}</span>
        </p>
      </h2>
      <h4 class="leading-7 text-base mt-0 mb-4 mx-0 text-sauvignon-800">
        <div>
          <span class="opacity-85">
            {t('hero.description')}
          </span>
        </div>
        <div class="mt-3">
          <span class="opacity-85">
            {t('hero.cta')}
          </span>
        </div>
      </h4>
    </div>
  </div>

  <div class="order-1 lg:order-2 lg:flex-1 flex items-end justify-center lg:pb-4">
    <Image
      src={promoImage}
      alt="be-wine chương trình mùa thu - mua 1 tặng 1"
      width={900}
      class="w-56 sm:w-64 lg:w-80 h-auto drop-shadow-xl"
      loading="eager"
    />
  </div>
</div>
