---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, useTranslatedPath } from "src/i18n/utils";
import hero1 from '../assets/figma/hero-1.jpg';
import hero2 from '../assets/figma/hero-2.jpg';
import hero3 from '../assets/figma/hero-3.jpg';
import heroMobile from '../assets/figma/hero-mobile.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// There's no English products/checkout flow yet (only the English home
// page exists) — send English visitors straight to Zalo instead of a
// dead /en/products link.
const orderHref = lang === 'en' ? 'https://zalo.me/3836034200863507097' : translatePath('/products');
---

<div>
  <div class="relative left-1/2 right-1/2 -mx-[50vw] w-screen h-screen md:h-[903px] overflow-hidden">
    <div class="relative h-full md:hidden overflow-hidden">
      <Image src={heroMobile} alt="be-wine" class="w-full h-full object-cover object-[center_25%]" loading="eager" />
    </div>
    <div class="hidden md:grid grid-cols-3 h-full">
      <div class="relative h-full overflow-hidden">
        <Image src={hero1} alt="" class="w-full h-full object-cover object-bottom" loading="eager" />
      </div>
      <div class="relative h-full overflow-hidden">
        <Image src={hero2} alt="" class="w-full h-full object-cover object-bottom" loading="eager" />
      </div>
      <div class="relative h-full overflow-hidden">
        <Image src={hero3} alt="" class="w-full h-full object-cover object-bottom" loading="eager" />
      </div>
    </div>
    <div class="hidden md:block absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(134,24,27,0.8) 67.788%)"></div>
    <div class="md:hidden absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, rgba(120,60,30,0) 0%, rgba(120,60,30,0.55) 70%, rgba(120,60,30,0.75) 100%)"></div>

    <img
      src="/figma/hero-wave-logo.svg"
      alt="be-wine"
      class="md:hidden absolute top-2 left-2 w-[95%] h-auto pointer-events-none drop-shadow-md"
    />

    <img
      src="/figma/hero-wave-logo.svg"
      alt="be-wine"
      class="hidden md:block absolute bottom-0 left-4 w-[97.8%] h-auto pointer-events-none"
    />

    <div class="md:hidden absolute inset-x-0 bottom-10 flex justify-center z-10">
      <a
        href={orderHref}
        target={lang === 'en' ? '_blank' : undefined}
        rel={lang === 'en' ? 'noopener' : undefined}
        class="inline-flex items-center justify-center bg-[#A71E22] text-sirah-50 font-sans font-bold uppercase text-lg rounded-xl px-8 py-4 shadow-lg"
      >
        {t('wheretofind.nav')}
      </a>
    </div>
  </div>
</div>
