              <circle cx="8.00" cy="1.79" r="0.42" fill="#fff" />
              <circle cx="10.00" cy="1.79" r="0.42" fill="#fff" />
              <circle cx="1.00" cy="2.99" r="0.42" fill="#fff" />
              <circle cx="3.00" cy="2.99" r="0.42" fill="#fff" />
              <circle cx="5.00" cy="2.99" r="0.42" fill="#fff" />
