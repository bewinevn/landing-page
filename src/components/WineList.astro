---
import { getEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Card from './Card.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getLocalizedWineList = () => {
    if (!lang || lang === 'vn') {
        return 'wines';
    }

    return lang + '/' + 'wines';
}

const wineList = await getEntry('wines', getLocalizedWineList());

---

<section id="WineList" class="relative w-full bg-sirah-50 px-5 py-16 md:px-[120px] md:py-20">
  <div class="max-w-[1200px] mx-auto flex flex-col gap-8">
    <h2 class="text-xl md:text-3xl uppercase font-bold tracking-wide text-[#86181b] m-0">
      {t('winelist.title')}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {wineList.data.list.map(
          (wine) =>
          <Card
            image={wine.image}
            title={wine.name}
            subtitle={wine.description} />
        )}
      </div>
  </div>
</section>
