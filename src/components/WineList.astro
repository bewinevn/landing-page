---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { listProducts } from '../modules/products';
import Card from './Card.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = lang === 'en' ? 'en' : 'vn';

const products = await listProducts(locale);
---

<section id="WineList" class="relative w-full bg-sirah-50 px-5 py-16 md:px-[120px] md:py-20">
  <div class="max-w-[1200px] mx-auto flex flex-col gap-8">
    <h2 class="text-xl md:text-3xl uppercase font-bold tracking-wide text-[#86181b] m-0">
      {t('winelist.title')}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map(
          (product) =>
          <Card
            image={product.imageUrl ?? ''}
            title={product.name}
            abbreviation={product.abbreviation}
            subtitle={product.description}
            isComingSoon={product.isComingSoon}
            productId={product.id}
            priceVnd={product.effectivePriceVnd}
            availableQty={product.availableQty}
            showAddToCart={!product.isComingSoon} />
        )}
      </div>
  </div>
</section>

<script src="../scripts/add-to-cart-buttons.ts"></script>
