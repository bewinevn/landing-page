---
interface Props {
  title: string;
  showNav?: boolean;
}
const { title, showNav = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, "Space Grotesk", Arial, sans-serif;
        margin: 0;
        background: #fafafa;
        color: #1a1a1a;
      }
      a { color: #A71E22; }
      .admin-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 24px;
        background: #A71E22;
        color: white;
      }
      .admin-nav a { color: white; text-decoration: none; font-weight: 700; }
      .admin-nav button {
        background: transparent;
        border: 1px solid white;
        color: white;
        border-radius: 6px;
        padding: 6px 14px;
        cursor: pointer;
        font-weight: 700;
        font-size: 13px;
      }
      .admin-main { max-width: 1000px; margin: 0 auto; padding: 24px; }
    </style>
  </head>
  <body>
    {showNav && (
      <div class="admin-nav">
        <a href="/admin/orders">be-wine admin — đơn hàng</a>
        <button id="admin-logout-btn" type="button">Đăng xuất</button>
      </div>
    )}
    <main class="admin-main">
      <slot />
    </main>
    {showNav && (
      <script>
        document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
          await fetch("/api/admin/logout", { method: "POST" });
          window.location.href = "/admin/login";
        });
      </script>
    )}
  </body>
</html>
