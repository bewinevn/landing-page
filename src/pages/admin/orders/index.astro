---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listOrdersForAdmin, type OrderStatus } from '../../../modules/orders';
import { getPaymentsByOrderIds } from '../../../modules/payments';
import { listProductsForAdmin } from '../../../modules/products';

const STATUSES: OrderStatus[] = [
  'pending_payment', 'paid', 'processing', 'shipped', 'completed', 'cancelled', 'refunded',
];

const statusParam = Astro.url.searchParams.get('status') ?? '';
const status = STATUSES.includes(statusParam as OrderStatus) ? (statusParam as OrderStatus) : undefined;
const search = Astro.url.searchParams.get('q') ?? '';

const { orders, total } = await listOrdersForAdmin({ status, search: search || undefined, limit: 50 });
const paymentsByOrderId = await getPaymentsByOrderIds(orders.map((o) => o.id));
const sellableProducts = (await listProductsForAdmin())
  .filter((p) => p.is_active)
  .map((p) => ({
    ...p,
    // The manual-order endpoint charges createOrder's effectivePrice()
    // (promo-aware) for every line, same as a real checkout — show that
    // same number here so the dropdown never disagrees with what the
    // order actually gets charged.
    effectivePriceVnd: p.is_promo && p.promo_price_vnd != null ? p.promo_price_vnd : p.price_vnd,
  }));

const STATUS_LABELS: Record<OrderStatus, string> = {
  pending_payment: 'Chờ thanh toán',
  paid: 'Đã thanh toán',
  processing: 'Đang xử lý',
  shipped: 'Đã giao vận chuyển',
  completed: 'Hoàn tất',
  cancelled: 'Đã huỷ',
  refunded: 'Đã hoàn tiền',
};
---

<AdminLayout title="be-wine admin — đơn hàng">
  <h1 style="font-size: 20px; margin: 0 0 16px;">Đơn hàng ({total})</h1>

  <div style="background: white; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
    <h2 style="font-size: 14px; text-transform: uppercase; color: #999; margin: 0 0 12px;">
      Tạo đơn thủ công (khách mua qua sales/ngoài website)
    </h2>
    <form id="manual-order-form">
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 8px;">
        <input name="fullName" placeholder="Tên khách hàng" required style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" />
        <input name="phone" placeholder="Số điện thoại" required style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" />
        <input name="addressLine" placeholder="Địa chỉ" value="Bán trực tiếp" required style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" />
        <input name="city" placeholder="Tỉnh/thành" value="Hà Nội" required style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" />
      </div>
      <input name="note" placeholder="Ghi chú (vd: người bán, kênh bán qua Zalo/điện thoại...)" style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 12px; box-sizing: border-box;" />

      <div id="manual-order-items">
        {[0, 1, 2].map(() => (
          <div class="manual-order-item-row" style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px; margin-bottom: 8px;">
            <select class="manual-order-product" style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;">
              <option value="">— Chọn sản phẩm —</option>
              {sellableProducts.map((p) => (
                <option value={p.id}>{p.name_vn} — {p.effectivePriceVnd.toLocaleString('vi-VN')}đ</option>
              ))}
            </select>
            <input type="number" class="manual-order-qty" min="1" placeholder="Số lượng" style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" />
          </div>
        ))}
      </div>
      <button type="button" id="manual-order-add-row" style="background: #f0f0f0; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 12px; font-weight: 700; cursor: pointer; margin-bottom: 12px;">
        + Thêm sản phẩm
      </button>
      <div>
        <button type="submit" style="background: #A71E22; color: white; border: none; border-radius: 6px; padding: 10px 20px; font-weight: 700; cursor: pointer;">
          Tạo đơn (đã thanh toán)
        </button>
        <span id="manual-order-error" hidden style="color: #A71E22; margin-left: 12px;"></span>
      </div>
    </form>
  </div>

  <form method="get" style="display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;">
    <select name="status" style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;">
      <option value="">Tất cả trạng thái</option>
      {STATUSES.map((s) => (
        <option value={s} selected={s === status}>{STATUS_LABELS[s]}</option>
      ))}
    </select>
    <input
      type="text"
      name="q"
      placeholder="Tìm theo mã đơn hoặc SĐT"
      value={search}
      style="padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; flex: 1; min-width: 200px;"
    />
    <button type="submit" style="padding: 8px 16px; border: none; border-radius: 6px; background: #A71E22; color: white; font-weight: 700; cursor: pointer;">
      Lọc
    </button>
  </form>

  <div style="overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; font-size: 14px; background: white; border-radius: 8px; overflow: hidden;">
      <thead>
        <tr style="text-align: left; border-bottom: 2px solid #eee;">
          <th style="padding: 10px;">Mã đơn</th>
          <th style="padding: 10px;">Khách hàng</th>
          <th style="padding: 10px;">Tổng tiền</th>
          <th style="padding: 10px;">Thanh toán</th>
          <th style="padding: 10px;">Trạng thái</th>
          <th style="padding: 10px;">Ngày tạo</th>
        </tr>
      </thead>
      <tbody>
        {orders.map((order) => {
          const payment = paymentsByOrderId.get(order.id);
          const paymentLabel =
            order.channel === 'offline'
              ? 'Bán trực tiếp'
              : payment?.provider === 'manual' ? 'COD' : payment?.provider === 'vietqr_static' ? 'QR' : (payment?.provider ?? '—');
          return (
            <tr style="border-bottom: 1px solid #f0f0f0;">
              <td style="padding: 10px;">
                <a href={`/admin/orders/${order.reference}`} style="font-weight: 700;">{order.reference}</a>
              </td>
              <td style="padding: 10px;">{order.delivery_full_name}<br /><span style="color: #999;">{order.delivery_phone}</span></td>
              <td style="padding: 10px;">{order.total_vnd.toLocaleString('vi-VN')} ₫</td>
              <td style="padding: 10px;">{paymentLabel}</td>
              <td style="padding: 10px;">{STATUS_LABELS[order.status]}</td>
              <td style="padding: 10px; color: #999;">{new Date(order.created_at).toLocaleString('vi-VN')}</td>
            </tr>
          );
        })}
        {orders.length === 0 && (
          <tr><td colspan="6" style="padding: 20px; text-align: center; color: #999;">Không có đơn hàng nào.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('manual-order-form') as HTMLFormElement;
  const itemsContainer = document.getElementById('manual-order-items')!;
  const addRowBtn = document.getElementById('manual-order-add-row')!;
  const errorEl = document.getElementById('manual-order-error')!;

  addRowBtn.addEventListener('click', () => {
    const firstRow = itemsContainer.querySelector('.manual-order-item-row') as HTMLElement;
    const clone = firstRow.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('select, input').forEach((el) => {
      (el as HTMLInputElement | HTMLSelectElement).value = '';
    });
    itemsContainer.appendChild(clone);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;

    const fd = new FormData(form);
    const items = Array.from(itemsContainer.querySelectorAll('.manual-order-item-row'))
      .map((row) => {
        const productId = (row.querySelector('.manual-order-product') as HTMLSelectElement).value;
        const quantity = parseInt((row.querySelector('.manual-order-qty') as HTMLInputElement).value || '0', 10);
        return { productId, quantity };
      })
      .filter((item) => item.productId && item.quantity > 0);

    if (items.length === 0) {
      errorEl.textContent = 'Chọn ít nhất 1 sản phẩm và số lượng.';
      errorEl.hidden = false;
      submitBtn.disabled = false;
      return;
    }

    try {
      const res = await fetch('/api/admin/orders/manual', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer: {
            fullName: fd.get('fullName'),
            phone: fd.get('phone'),
            addressLine: fd.get('addressLine'),
            city: fd.get('city'),
            note: fd.get('note') || undefined,
          },
          items,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error?.message ?? 'Có lỗi xảy ra, vui lòng thử lại.');
      window.location.href = `/admin/orders/${data.orderReference}`;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Có lỗi xảy ra, vui lòng thử lại.';
      errorEl.hidden = false;
      submitBtn.disabled = false;
    }
  });
</script>
