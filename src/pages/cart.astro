---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from 'src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = lang === 'en' ? 'en' : 'vn';
---

<Layout title="be-wine — cart">
  <div class="mx-auto px-5 md:px-[120px] py-16 max-w-[800px]">
    <h1 class="text-2xl md:text-4xl uppercase font-bold tracking-wide text-[#86181b] m-0 mb-8">
      {t('cart.title')}
    </h1>

    <div id="cart-empty" hidden class="text-[#666] py-12 text-center">
      <p>{t('cart.empty')}</p>
      <a href="/products" class="inline-block mt-4 text-[#A71E22] font-bold no-underline hover:underline">
        {t('cart.continueShopping')}
      </a>
    </div>

    <div id="cart-lines" class="flex flex-col gap-4"></div>

    <div id="cart-summary" hidden class="mt-8 flex flex-col gap-4 items-end">
      <p class="text-lg font-bold text-[#A71E22] m-0">
        {t('cart.subtotal')}: <span id="cart-subtotal">0 ₫</span>
      </p>
      <a
        id="cart-checkout-btn"
        href="/checkout"
        class="inline-flex items-center justify-center rounded bg-[#A71E22] text-white font-sans font-bold text-base px-8 py-3 no-underline hover:brightness-110 transition"
      >
        {t('cart.checkout')}
      </a>
    </div>
  </div>
</Layout>

<script define:vars={{ locale, removeLabel: t('cart.remove') }}>
  window.__BEWINE_LOCALE__ = locale;
  window.__BEWINE_I18N__ = { remove: removeLabel };
</script>
<script src="../scripts/cart-page.ts"></script>
