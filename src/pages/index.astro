---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutUs from '../components/AboutUs.astro';
import OurQuality from '../components/OurQuality.astro';
import WineList from '../components/WineList.astro';

// Cache the rendered page at Netlify's edge so visitors don't wait on a
// function + database round trip every time.
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
---

<Layout title="be-wine">
  <div class="relative">
    <Hero />
    <AboutUs />
    <OurQuality />
    <WineList />
  </div>
</Layout>
