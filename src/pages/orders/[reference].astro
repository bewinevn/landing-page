---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from 'src/i18n/utils';
import { getOrderDetail } from '../../modules/orders';
import { getPaymentByReference } from '../../modules/payments';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { reference } = Astro.params;

let order, items, payment;
try {
  ({ order, items } = await getOrderDetail(reference!));
  payment = await getPaymentByReference(reference!);
} catch {
  return Astro.redirect('/');
}

const PAID_STATUSES = new Set(['paid', 'processing', 'shipped', 'completed']);
const isPaidInitially = PAID_STATUSES.has(order.status);
const isCod = payment.provider === 'manual';
---

<Layout title={`be-wine — order ${order.reference}`}>
  <div class="mx-auto px-5 md:px-[120px] py-16 max-w-[700px]">
    {isCod && (
      <div id="order-cod-block">
        <h1 class="text-2xl md:text-3xl uppercase font-bold tracking-wide text-[#86181b] m-0 mb-2">
          {t('order.codTitle')}
        </h1>
        <p class="text-[#666] mb-4">{t('order.codDesc')}</p>
        <div class="flex flex-col gap-2 text-sm max-w-xs">
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.reference')}</span><span class="font-bold text-[#A71E22]">{order.reference}</span></p>
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.amount')}</span><span class="font-bold text-[#A71E22]">{payment.amountExpectedVnd.toLocaleString('vi-VN')} ₫</span></p>
        </div>
      </div>
    )}
    <div id="order-waiting-block" hidden={isCod || isPaidInitially}>
      <h1 class="text-2xl md:text-3xl uppercase font-bold tracking-wide text-[#86181b] m-0 mb-2">
        {t('order.waitingTitle')}
      </h1>
      <p class="text-[#666] mb-8">{t('order.waitingDesc')}</p>

      <div class="flex flex-col md:flex-row gap-8 items-start">
        <img src={payment.qrCodeUrl} alt="VietQR" class="w-64 h-64 object-contain rounded-lg border border-[#d1d5db] shrink-0" />

        <div class="flex-1 flex flex-col gap-2 text-sm">
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.reference')}</span><span class="font-bold text-[#A71E22]">{order.reference}</span></p>
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.amount')}</span><span class="font-bold text-[#A71E22]">{payment.amountExpectedVnd.toLocaleString('vi-VN')} ₫</span></p>
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.bankName')}</span><span class="font-medium">{payment.bankName}</span></p>
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.bankAccount')}</span><span class="font-medium">{payment.bankAccountNumber}</span></p>
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.accountHolder')}</span><span class="font-medium">{payment.bankAccountHolder}</span></p>
          <p class="flex justify-between m-0"><span class="text-[#666]">{t('order.transferContent')}</span><span class="font-bold text-[#A71E22]">{order.reference}</span></p>
          <p class="mt-4 text-xs text-[#999] m-0">{t('order.expiresNote')}</p>

          <div id="order-status-indicator" class="mt-4 flex items-center gap-2 text-sm text-[#666]">
            <span class="inline-block w-2 h-2 rounded-full bg-[#A71E22] animate-pulse"></span>
            <span>{t('order.waitingTitle')}...</span>
          </div>
        </div>
      </div>
    </div>

    <div id="order-paid-block" hidden={isCod || !isPaidInitially}>
      <h1 class="text-2xl md:text-3xl uppercase font-bold tracking-wide text-[#86181b] m-0 mb-2">
        {t('order.paidTitle')}
      </h1>
      <p class="text-[#666] mb-8">{t('order.paidDesc')}</p>
      <p class="text-sm text-[#666]">{t('order.reference')}: <span class="font-bold text-[#A71E22]">{order.reference}</span></p>
    </div>

    <div class="mt-10 pt-6 border-t border-[#d1d5db]">
      <h2 class="text-sm uppercase font-bold text-[#86181b] m-0 mb-3">{t('checkout.orderSummary')}</h2>
      <div class="flex flex-col gap-2">
        {items.map((item) => (
          <p class="flex justify-between text-sm m-0">
            <span class="text-[#666] capitalize">{item.product_name_snapshot} &times; {item.quantity}</span>
            <span class="font-medium text-[#A71E22]">{item.line_total_vnd.toLocaleString('vi-VN')} ₫</span>
          </p>
        ))}
      </div>
      <p class="flex justify-between font-bold text-[#A71E22] mt-3 pt-3 border-t border-[#d1d5db]">
        <span>{t('checkout.total')}</span>
        <span>{order.total_vnd.toLocaleString('vi-VN')} ₫</span>
      </p>
    </div>
  </div>
</Layout>

{!isCod && (
  <>
    <script define:vars={{ reference: order.reference, paidTitle: t('order.paidTitle'), paidDesc: t('order.paidDesc') }}>
      window.__BEWINE_ORDER_REFERENCE__ = reference;
      window.__BEWINE_I18N__ = { paidTitle, paidDesc };
    </script>
    <script src="../../scripts/order-status-poller.ts"></script>
  </>
)}
