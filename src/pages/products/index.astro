---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from 'src/i18n/utils';
import { listProducts } from '../../modules/products';
import zaloLogo from '../../assets/zalo-combined.webp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = lang === 'en' ? 'en' : 'vn';

const products = await listProducts(locale);
const defaultProduct = products.find((p) => !p.isComingSoon) ?? products[0];

// Deep link from the homepage's "exclusive in combo" cards (Sauvignon
// Blanc / Zinfandel) — they aren't sold standalone, only the combo picker
// option unlocks them, so /products?combo=1 pre-selects it instead of
// landing on the default wine.
const preselectCombo = Astro.url.searchParams.get('combo') === '1';

const sauvignonBlanc = products.find((p) => p.slug === 'sauvignon-blanc');
const zinfandel = products.find((p) => p.slug === 'zinfandel');
const petiteSirah = products.find((p) => p.slug === 'petite-sirah');

// Can quantity tiers for single wines.
const QUANTITY_TIERS = [3, 6, 12, 24];

// Combo trải nghiệm: a 4th "wine type" in the picker (not a real product)
// — a fixed 2 Petite Sirah + 2 Sauvignon Blanc + 2 Zinfandel per combo,
// flat 250,000đ. Quantity here means number of combos (1-4), not cans.
const COMBO_PS_UNIT_VND = 50_000;
const COMBO_SB_UNIT_VND = 45_000;
const COMBO_ZL_UNIT_VND = 30_000;
const CANS_PER_WINE_PER_COMBO = 2;
const COMBO_PRICE_VND = (COMBO_PS_UNIT_VND + COMBO_SB_UNIT_VND + COMBO_ZL_UNIT_VND) * CANS_PER_WINE_PER_COMBO;
const COMBO_QUANTITY_OPTIONS = [1, 2, 3, 4];
const maxComboQty = Math.min(
  4,
  Math.floor((petiteSirah?.availableQty ?? 0) / CANS_PER_WINE_PER_COMBO),
  Math.floor((sauvignonBlanc?.availableQty ?? 0) / CANS_PER_WINE_PER_COMBO),
  Math.floor((zinfandel?.availableQty ?? 0) / CANS_PER_WINE_PER_COMBO),
);
---

<style>
  .card-texture {
    background-image: url("../../assets/topography.svg");
    background-size: 384px 384px;
    background-position: top left;
    opacity: 0.5;
  }

  /* Combo picker button: border blends the 3 wines' own colors (Petite
     Sirah red, Sauvignon Blanc green, Zinfandel magenta) when selected,
     instead of the plain single-color border other wine buttons use —
     it represents all three at once. Text stays the normal brand red. */
  .combo-picker-btn[data-selected="true"] {
    border-color: transparent;
    background-image:
      linear-gradient(#fff, #fff),
      linear-gradient(90deg, #A71E22, #3CAA44, #9C2A4C);
    background-origin: border-box;
    background-clip: padding-box, border-box;
  }
</style>

<Layout title="be-wine">
  <div class="mx-auto px-5 md:px-[120px] py-16 max-w-[1100px]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
      <div id="configurator-image-frame" class:list={["relative overflow-hidden rounded-lg bg-[#EFEDE9] flex items-center justify-center h-[320px] md:h-[440px]", !preselectCombo && "p-6"]}>
        <div id="configurator-image-texture" class:list={["card-texture absolute inset-0 pointer-events-none", preselectCombo && "invisible"]}></div>
        <img id="configurator-image" src={preselectCombo ? '/images/products/combo.webp' : (defaultProduct?.imageUrl ?? '')} alt="" class="relative max-h-full w-auto object-contain" />
      </div>

      <div class="flex flex-col gap-6">
        <div>
          <h1 id="configurator-title" class="text-2xl md:text-3xl font-bold text-[#86181b] m-0 capitalize">
            {preselectCombo ? t('product.comboName') : defaultProduct?.name}
          </h1>
          <p class="m-0 mt-2 text-xl font-bold text-[#A71E22]">
            <span id="configurator-unit-price">{(preselectCombo ? COMBO_PRICE_VND : defaultProduct?.effectivePriceVnd ?? 0).toLocaleString('vi-VN')}</span> ₫
            <span id="configurator-unit-suffix" class="text-sm font-normal text-[#666]">{preselectCombo ? t('product.comboPerUnit') : t('product.perCan')}</span>
          </p>
        </div>

        <div>
          <p class="m-0 mb-2 text-sm text-[#666]">{t('product.wineType')}</p>
          <div class="flex flex-wrap gap-2">
            {petiteSirah && (
              <button
                type="button"
                data-wine-option
                data-product-id={petiteSirah.id}
                data-product-slug={petiteSirah.slug}
                data-product-name={petiteSirah.name}
                data-product-image={petiteSirah.imageUrl ?? ''}
                data-unit-price={petiteSirah.effectivePriceVnd}
                data-available-qty={petiteSirah.availableQty}
                data-unit-suffix={t('product.perCan')}
                disabled={petiteSirah.isComingSoon}
                class="px-4 py-2 rounded-full border-2 border-[#d1d5db] font-sans font-bold text-sm capitalize disabled:opacity-50 disabled:cursor-not-allowed data-[selected=true]:border-[#A71E22] data-[selected=true]:text-[#A71E22]"
                data-selected={!preselectCombo && petiteSirah.id === defaultProduct?.id ? 'true' : 'false'}
              >
                {petiteSirah.name}
              </button>
            )}
            <button
              type="button"
              data-wine-option
              data-combo="true"
              data-product-slug="combo"
              data-product-name={t('product.comboName')}
              data-product-image="/images/products/combo.webp"
              data-unit-price={COMBO_PRICE_VND}
              data-available-qty={maxComboQty}
              data-unit-suffix={t('product.comboPerUnit')}
              data-combo-ps-id={petiteSirah?.id ?? ''}
              data-combo-sb-id={sauvignonBlanc?.id ?? ''}
              data-combo-zl-id={zinfandel?.id ?? ''}
              disabled={maxComboQty === 0}
              class="combo-picker-btn px-4 py-2 rounded-full border-2 border-[#d1d5db] font-sans font-bold text-sm capitalize disabled:opacity-50 disabled:cursor-not-allowed data-[selected=true]:text-[#A71E22]"
              data-selected={preselectCombo ? 'true' : 'false'}
            >
              {t('product.comboName')}
            </button>
            {products.filter((product) => product.slug !== 'petite-sirah').map((product) => (
              <button
                type="button"
                data-wine-option
                data-product-id={product.id}
                data-product-slug={product.slug}
                data-product-name={product.name}
                data-product-image={product.imageUrl ?? ''}
                data-unit-price={product.effectivePriceVnd}
                data-available-qty={product.availableQty}
                data-unit-suffix={t('product.perCan')}
                disabled={product.isComingSoon}
                class="px-4 py-2 rounded-full border-2 border-[#d1d5db] font-sans font-bold text-sm capitalize disabled:opacity-50 disabled:cursor-not-allowed data-[selected=true]:border-[#A71E22] data-[selected=true]:text-[#A71E22]"
                data-selected={!preselectCombo && product.id === defaultProduct?.id ? 'true' : 'false'}
              >
                {product.name}
              </button>
            ))}
          </div>
        </div>

        <div>
          <p class="m-0 mb-2 text-sm text-[#666]">{t('product.packageLabel')}</p>

          <div id="can-qty-section" hidden={preselectCombo}>
            <div class="grid grid-cols-4 gap-2">
              {QUANTITY_TIERS.map((qty, i) => (
                <button
                  type="button"
                  data-qty-option
                  data-qty={qty}
                  data-selected={!preselectCombo && i === 0 ? 'true' : 'false'}
                  class="px-2 py-2 rounded-full border-2 border-[#d1d5db] font-sans font-bold text-sm text-center disabled:opacity-50 disabled:cursor-not-allowed data-[selected=true]:border-[#A71E22] data-[selected=true]:text-[#A71E22]"
                >
                  {`${qty} ${t('product.canUnit')}`}
                </button>
              ))}
            </div>
          </div>

          <div id="combo-qty-section" hidden={!preselectCombo}>
            <div class="grid grid-cols-4 gap-2">
              {COMBO_QUANTITY_OPTIONS.map((qty, i) => (
                <button
                  type="button"
                  data-qty-option
                  data-qty={qty}
                  data-selected={preselectCombo && i === 0 ? 'true' : 'false'}
                  class="px-2 py-2 rounded-full border-2 border-[#d1d5db] font-sans font-bold text-sm text-center disabled:opacity-50 disabled:cursor-not-allowed data-[selected=true]:border-[#A71E22] data-[selected=true]:text-[#A71E22]"
                >
                  {`${qty} ${t('product.comboUnit')}`}
                </button>
              ))}
            </div>
            <p class="m-0 mt-2 text-xs text-[#999]">{t('product.comboDescription')}</p>
          </div>
        </div>

        <p class="font-bold text-[#A71E22] text-xl m-0" id="configurator-total"></p>

        <button
          type="button"
          id="configurator-checkout"
          class="w-full inline-flex items-center justify-center rounded-full bg-[#A71E22] text-white font-sans font-bold text-base px-8 py-4 hover:brightness-110 transition disabled:bg-[#ccc] disabled:cursor-not-allowed"
        >
          {t('product.buyNow')}
        </button>

        <a
          href="https://zalo.me/3836034200863507097"
          target="_blank"
          rel="noopener"
          class="w-full inline-flex items-center justify-center gap-2 rounded-full border-2 border-[#0068FF] text-[#0068FF] font-sans font-bold text-base px-8 py-4 hover:bg-[#0068FF]/5 transition"
        >
          {t('product.contactZaloPrefix')}
          <Image src={zaloLogo} alt="Zalo" width={2000} height={2000} class="h-6 w-6" />
        </a>
      </div>
    </div>
  </div>
</Layout>

<script src="../../scripts/product-configurator.ts"></script>
