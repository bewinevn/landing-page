---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { getLangFromUrl, useTranslations } from 'src/i18n/utils';
import { listProducts } from '../../modules/products';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = lang === 'en' ? 'en' : 'vn';

const products = await listProducts(locale);
---

<Layout title="be-wine">
  <div class="mx-auto px-5 md:px-[120px] py-16 max-w-[1440px]">
    <h1 class="text-2xl md:text-4xl uppercase font-bold tracking-wide text-[#86181b] m-0 mb-8">
      {t('winelist.title')}
    </h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product) => (
        <a href={`/products/${product.slug}`} class="no-underline block">
          <figure class="relative flex flex-col gap-3 items-start p-4 rounded-lg bg-[#EFEDE9] overflow-hidden m-0">
            <img class="w-full h-[220px] object-contain" loading="lazy" alt={product.name} src={product.imageUrl ?? ''} />
            <div class="flex items-center gap-2 w-full">
              <p class="font-sans font-bold text-[#A71E22] text-xl m-0 capitalize">{product.name}</p>
              {product.abbreviation && (
                <span class="inline-flex items-center justify-center h-[26px] w-[38px] rounded bg-white border border-[#d1d5db] font-sans font-bold text-[#A71E22] text-sm">
                  {product.abbreviation}
                </span>
              )}
            </div>
            <p class="text-[#A71E22] font-bold text-lg m-0">
              {product.isComingSoon ? t('winelist.comingsoon') : `${product.effectivePriceVnd.toLocaleString('vi-VN')} ₫`}
            </p>
          </figure>
        </a>
      ))}
    </div>
  </div>
</Layout>
